# Copier ce fichier en .env (ne jamais commiter le .env) :
#   cp .env.example .env

# --- PostgreSQL (Local) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pulse
DB_USERNAME=pulse
DB_PASSWORD=change_me

# --- JPA ---
# update (local) | validate (recette/prod) | none
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# --- Serveur ---
SERVER_PORT=8080

# --- Supabase ---
# Cles : Dashboard Supabase > Project Settings > API Keys
SUPABASE_URL=https://jxvimatjovqzcbfnkvrz.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Cle secrete : uniquement cote serveur, jamais dans le front ni dans git
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://jxvimatjovqzcbfnkvrz.supabase.co/auth/v1/.well-known/jwks.json
